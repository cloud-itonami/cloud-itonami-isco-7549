;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a workshop scheduling/logistics coordination
;; robot schedules a craft workshop crew, logs commissions and coordinates
;; craft-materials supply; it never does the craft work. Its physical work is
;; workshop logistics: carrying material bins between the store and the
;; benches, and shelving finished pieces.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-7549"
 :cases
 [{:id :material-bin-to-bench
   :kind :transport
   :procedure "AMR carries stacked material bins from the materials store to the craft benches"
   :params {:mass-kg 40.0 :distance-m 30.0 :v-max-mps 1.0 :a-max-mps2 0.5
            :brake-decel-mps2 1.0 :drive-force-n 90.0 :crr 0.02
            :cog-height-m 0.30 :payload-cog-height-m 0.55 :support-half-length-m 0.30
            :max-time-s 600.0}
   :sweep {:param :payload-kg :values [10.0 25.0 50.0 90.0 140.0]}
   :quantity :cycle-time-s
   :limit {:max 45.0 :basis "estimate: one bin delivery within the 45 s slot between bench requests"}
   :boundary {:lo 5.0 :hi 400.0}}
  {:id :piece-onto-shelf
   :kind :manipulator
   :procedure "arm lifts a finished piece from the bench onto the drying/display shelf"
   :params {:l1-m 0.50 :l2-m 0.45 :m1-kg 5.0 :m2-kg 3.5
            :from [0.55 0.05] :to [0.25 0.80] :duration-s 2.0 :steps 400}
   :sweep {:param :payload-kg :values [0.5 2.0 4.0 6.0 9.0]}
   :quantity :peak-tau1-nm
   :limit {:max 80.0 :basis "estimate: continuous shoulder torque of a ~7 kg-class collaborative arm"}
   :boundary {:lo 0.1 :hi 40.0}}]}
